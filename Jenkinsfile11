pipeline {
  agent any

   options {
        skipDefaultCheckout(true)
    }

    stages {
        stage('Code Checkout') {
            steps {
                script {
                    def scmInfo = checkout scm
                    def remoteUrl = scmInfo.GIT_URL ?: sh(
                        script: 'git config --get remote.origin.url',
                        returnStdout: true
                    ).trim()
                    def branchName = scmInfo.GIT_BRANCH ?: env.BRANCH_NAME ?: 'unknown'

                    env.REPOSITORY_URL = remoteUrl
                    env.REPOSITORY_NAME = remoteUrl.tokenize('/').last().replaceFirst(/\.git$/, '')
                    env.CURRENT_BRANCH = branchName.replaceFirst(/^origin\//, '')

                    echo "Repository: ${env.REPOSITORY_NAME}"
                    echo "Remote URL: ${env.REPOSITORY_URL}"
                    echo "Current branch: ${env.CURRENT_BRANCH}"
                }

                sh 'ls -la'
            }
        }

      stage('Build') {
      agent {
        docker { image 'django:latest' }
      }
      steps {
            // Run the Django server in the foreground
            sh 'python3 manage.py check' 
            echo 'Django server started. Proceeding to next stage...'
      }
    }

    stage('Deploy') {
      steps {
        // Build the image
        sh 'docker build -t todo .'
        
        // Run the container with a specific name (e.g., 'todo_container')
        sh 'docker run -d -p 8000:8000 --name todo_container todo'
      }
      post {
        always {
          echo 'Waiting for 2 minutes before stopping and deleting containers...'
          // Sleep for 2 minutes before stopping and deleting containers
          sleep 120

          // Stop the container using its name
          echo 'Stopping container...'
          sh 'docker stop todo_container'

          // Remove the container
          echo 'Removing container....'
          sh 'docker rm todo_container'
        }
      }
    }
  }
}
